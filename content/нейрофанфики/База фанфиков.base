filters:
  and:
    - file.folder.contains("нейрофанфики")
    - "file.name != this.file.name "
    - file.name != "нейрофанфики"
formulas:
  объем: aliases[0]
  Untitled: aliases[1]
  Untitled 2: if(aliases[1]=="джен", "-", 🔮actors[0].split(" ")[0]+"/"+🔮actors[1].split(" ")[0])
properties:
  formula.Untitled:
    displayName: категория
  formula.Untitled 2:
    displayName: пейринг
views:
  - type: table
    name: Таблица
    order:
      - file.name
      - file.mtime
      - formula.объем
      - formula.Untitled
      - formula.Untitled 2
      - file.folder
      - 🔮actors
      - 🔮chronology
      - aliases
    sort:
      - property: formula.Untitled 2
        direction: DESC
      - property: file.folder
        direction: DESC
      - property: formula.объем
        direction: DESC
      - property: formula.Untitled
        direction: ASC
      - property: file.mtime
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      formula.объем: 98
      file.folder: 164
