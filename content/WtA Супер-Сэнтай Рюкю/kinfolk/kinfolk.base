filters:
  and:
    - file.folder.contains("kin")
    - '!file.name.startsWith("kin")'
formulas:
  vitr-cover: |
    if(file.embeds[0].containsAny("jpg","png","gif","webp","jpeg","avif"), file.embeds[0])
  Untitled: if(file.name.startsWith("0"), "--> ", if(file.name.startsWith("O"), "--> ", ""))
  День недели: 🔮lastdate.format("dd DD MMM YYYY")
  Untitled 2: aliases[0]
  Untitled 3: file.folder.split("/")[-1]
properties:
  formula.Untitled:
    displayName: Название истории
  formula.Untitled 2:
    displayName: aliases0
  formula.Untitled 3:
    displayName: lastfolder
views:
  - type: table
    name: Table
    order:
      - file.name
      - formula.Untitled 3
      - kin-rate
      - kin-пара
      - breedable
    sort:
      - property: breedable
        direction: DESC
      - property: formula.Untitled 3
        direction: ASC
      - property: kin-пара
        direction: ASC
    columnSize:
      formula.Untitled 3: 165
      note.rate: 139
  - type: table
    name: женщины
    filters:
      and:
        - breedable == "f"
    order:
      - file.name
      - formula.Untitled 3
      - kin-пара
    sort:
      - property: formula.Untitled 3
        direction: ASC
  - type: table
    name: мужчины
    filters:
      and:
        - breedable != "f"
    order:
      - file.name
      - formula.Untitled 3
      - kin-пара
      - breedable
    sort:
      - property: formula.Untitled 3
        direction: ASC
  - type: table
    name: без нехочуш
    filters:
      and:
        - formula["Untitled 3"] != "не хочу"
    order:
      - file.name
      - formula.Untitled 3
      - breedable
      - kin-rate
      - kin-пара
    sort:
      - property: formula.Untitled 3
        direction: ASC
      - property: breedable
        direction: DESC
    columnSize:
      formula.Untitled 3: 165
      note.rate: 139
